# ==============================================================================
# AapadaOps Production Environment Configuration Template
# Copy to .env and populate with genuine secure credentials for production deployment.
# WARNING: NEVER COMMIT THE ACTUAL .env FILE OR SECRETS TO SOURCE CONTROL.
# ==============================================================================

# Application Metadata
APP_NAME=AapadaOps
APP_ENV=production
APP_VERSION=1.0.0
DEBUG=false
PORT=8000

# Cryptographic Secret Key (Generate with: openssl rand -hex 32)
# Required for signing JWT authentication tokens and session integrity
SECRET_KEY=CHANGE_THIS_TO_A_64_CHAR_CRYPTOGRAPHIC_RANDOM_SECRET_KEY_IN_PRODUCTION

# JWT Token Lifespans
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (PostgreSQL 16 with PostGIS 3.4 Extension)
# Local Docker Compose format:
# postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
POSTGRES_USER=aapadaops_admin
POSTGRES_PASSWORD=GENERATE_STRONG_DATABASE_PASSWORD_HERE
POSTGRES_DB=aapadaops
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://aapadaops_admin:GENERATE_STRONG_DATABASE_PASSWORD_HERE@db:5432/aapadaops

# Spatial Reference System Identifier (WGS 84 GPS standard)
DEFAULT_SRID=4326

# Redis Connection (Distributed WebSockets & Rate Limiting)
REDIS_PASSWORD=GENERATE_STRONG_REDIS_PASSWORD_HERE
REDIS_PORT=6379
REDIS_URL=redis://:GENERATE_STRONG_REDIS_PASSWORD_HERE@redis:6379/0

# Secure File Upload Configuration (Evidence Photos, Audio, PDFs)
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_BYTES=15728640

# Permitted CORS Origins (JSON formatted array of authorized domains)
BACKEND_CORS_ORIGINS=["https://aapadaops.osdma.gov.in", "https://eoc.odisha.gov.in"]

# Rate Limiting Controls (Requests per minute per client IP)
DEFAULT_RATE_LIMIT_PER_MINUTE=120
SUBMIT_RATE_LIMIT_PER_MINUTE=15

# AI / ML Service Configuration
# Configure your production LLM API key here (Optional: Engine defaults to deterministic heuristics if unset)
AI_PROVIDER=gemini
AI_API_KEY=YOUR_GEMINI_OR_VERTEX_AI_API_KEY_HERE
AI_CONFIDENCE_THRESHOLD=0.60

# Observability & Error Monitoring (Optional: Sentry DSN)
# SENTRY_DSN=https://your-public-key@sentry.io/project-id

# Ports for Docker Compose exposure
FRONTEND_PORT=80
FRONTEND_SSL_PORT=443
BACKEND_PORT=8000
