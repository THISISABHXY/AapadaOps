# AapadaOps Environment Configuration Template
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL
# Copy this file to .env and populate with deployment-specific credentials

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
APP_ENV=development
APP_NAME=AapadaOps
APP_PORT=8000
APP_HOST=0.0.0.0
DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-64-character-hex-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=120
ALGORITHM=HS256

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL + PostGIS)
# -----------------------------------------------------------------------------
POSTGRES_USER=aapada_admin
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aapadaops_db
# Async Database URL for SQLAlchemy 2
DATABASE_URL=postgresql+asyncpg://aapada_admin:your_secure_db_password_here@localhost:5432/aapadaops_db
# Fallback SQLite Database URL for local testing without Postgres:
# DATABASE_URL=sqlite+aiosqlite:///./aapadaops_dev.db

# -----------------------------------------------------------------------------
# Redis Configuration (Cache, Rate Limiting, Celery/Task Queue)
# -----------------------------------------------------------------------------
REDIS_ENABLED=False
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# -----------------------------------------------------------------------------
# External Services & APIs (Optional - Simulated mode active when empty)
# -----------------------------------------------------------------------------
# India Meteorological Department (IMD) API endpoint / key
IMD_API_KEY=
IMD_API_BASE_URL=https://mausam.imd.gov.in/api/v1

# Central Water Commission (CWC) Flood Monitoring API
CWC_API_KEY=
CWC_API_BASE_URL=https://ffs.india-water.gov.in/api

# OpenRouteService / OSRM routing endpoint for rescue dispatch
ROUTING_SERVICE_URL=http://localhost:5000/route/v1

# SMS / Alert Broadcast Gateway (Govt CDAC / SMS Gateway)
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=OSDMA-ALERT

# -----------------------------------------------------------------------------
# Frontend Settings
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_MAP_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_ODISHA_DEFAULT_LAT=20.9517
VITE_ODISHA_DEFAULT_LNG=85.0985
VITE_ODISHA_DEFAULT_ZOOM=7
